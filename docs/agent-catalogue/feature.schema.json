{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CS PILOT — catalogue fonctionnel par domaine",
  "description": "Contrat des fichiers de domaine. Les références au dépôt, l'unicité globale et la cohérence domaine/ID sont contrôlées par scripts/validate_feature_catalogue.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "features"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "domain": {
      "enum": ["interface", "temps", "rh", "finances", "association", "administration"]
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "texts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*[\\\\*?\\[\\]]).+$"
      }
    },
    "feature_id": {
      "type": "string",
      "pattern": "^(interface|temps|rh|finances|association|administration)\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "purpose", "example_requests", "capabilities", "entry_points",
        "implementation", "access", "invariants", "extension_points", "related_features", "limitations"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/feature_id"},
        "title": {"$ref": "#/$defs/text"},
        "purpose": {"$ref": "#/$defs/text"},
        "example_requests": {"$ref": "#/$defs/texts"},
        "capabilities": {"$ref": "#/$defs/texts"},
        "entry_points": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route_files", "service_files", "templates", "tables", "tests", "docs"],
          "properties": {
            "route_files": {"$ref": "#/$defs/paths"},
            "service_files": {"$ref": "#/$defs/paths"},
            "templates": {"$ref": "#/$defs/paths"},
            "tables": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
            },
            "tests": {"$ref": "#/$defs/paths"},
            "docs": {"$ref": "#/$defs/paths"}
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "scope", "conditions", "sources"],
          "properties": {
            "summary": {"$ref": "#/$defs/text"},
            "scope": {"$ref": "#/$defs/text"},
            "conditions": {"$ref": "#/$defs/texts"},
            "sources": {"$ref": "#/$defs/paths"}
          }
        },
        "invariants": {"$ref": "#/$defs/texts"},
        "extension_points": {"$ref": "#/$defs/texts"},
        "related_features": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/feature_id"}
        },
        "limitations": {"$ref": "#/$defs/texts"}
      }
    }
  }
}
