{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs-pilot.fr/schemas/decision-v1.schema.json",
  "title": "Décision privée du pilote CS-PILOT v1",
  "description": "Compte rendu argumenté ; le score se recalcule avec triage_agent.py. La conformité structurelle ne vérifie ni les preuves ni une autorisation. Ne pas publier les décisions réelles dans le dépôt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "reference",
    "version_perimetre",
    "manifest_sha256",
    "revision_sources",
    "date_analyse",
    "evaluation",
    "decision",
    "score",
    "cible_metier",
    "capacites_examinees",
    "preuves",
    "justification_notes",
    "hypotheses",
    "questions",
    "criteres_recette"
  ],
  "properties": {
    "format": {
      "const": "cspilot.decision"
    },
    "version": {
      "const": 1
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "version_perimetre": {
      "type": "integer",
      "minimum": 1,
      "description": "Version exacte de l'instantané du périmètre analysé dans ce dossier ; distincte de la version du format et du commit des sources. Vérifier son existence et sa correspondance dans le journal avant de réutiliser la décision."
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_sources": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "date_analyse": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acces_manquant",
        "action_interdite",
        "besoin_complet",
        "conflit_reference",
        "contenu_suspect",
        "doublon",
        "integrite_verifiee",
        "preuves_completes",
        "source_verifiee",
        "couverture",
        "risque",
        "notes"
      ],
      "properties": {
        "acces_manquant": {
          "type": "boolean"
        },
        "action_interdite": {
          "type": "boolean"
        },
        "besoin_complet": {
          "type": "boolean"
        },
        "conflit_reference": {
          "type": "boolean"
        },
        "contenu_suspect": {
          "type": "boolean"
        },
        "doublon": {
          "type": "boolean"
        },
        "integrite_verifiee": {
          "type": "boolean"
        },
        "preuves_completes": {
          "type": "boolean"
        },
        "source_verifiee": {
          "type": "boolean"
        },
        "couverture": {
          "enum": [
            "complete",
            "partielle",
            "absente"
          ]
        },
        "risque": {
          "enum": [
            "faible",
            "modere",
            "eleve"
          ]
        },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valeur",
            "mutualisation",
            "frequence",
            "maintenabilite",
            "simplicite"
          ],
          "properties": {
            "valeur": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "mutualisation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "frequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "maintenabilite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "simplicite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        }
      }
    },
    "decision": {
      "enum": [
        "quarantaine",
        "rattacher_doublon",
        "refuser",
        "clarifier_acces",
        "orienter_existant",
        "clarifier",
        "validation_humaine",
        "reporter",
        "ameliorer_existant",
        "creer_module"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "cible_metier": {
      "type": "string",
      "minLength": 1
    },
    "capacites_examinees": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preuves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "constat"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "constat": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "justification_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valeur",
        "mutualisation",
        "frequence",
        "maintenabilite",
        "simplicite"
      ],
      "properties": {
        "valeur": {
          "type": "string",
          "minLength": 1
        },
        "mutualisation": {
          "type": "string",
          "minLength": 1
        },
        "frequence": {
          "type": "string",
          "minLength": 1
        },
        "maintenabilite": {
          "type": "string",
          "minLength": 1
        },
        "simplicite": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criteres_recette": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
